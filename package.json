{
  "name": "xtag",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private per-post labels for X",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:safari": "wxt build -b safari",
    "build:all": "npm run build && npm run build:firefox && npm run build:safari",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "package": "node scripts/package.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@wxt-dev/module-react": "^1.1.0",
    "fake-indexeddb": "^6.2.0",
    "fflate": "^0.8.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.0",
    "vitest": "5.0.5",
    "wxt": "0.21.4"
  }
}
